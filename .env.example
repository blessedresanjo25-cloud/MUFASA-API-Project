# Copy this file to .env and fill in the real values.
# This project loads .env automatically via dotenv/config.

# Required for AI Studio / Gemini API integration.
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# Optional: public URL for your deployed app.
APP_URL="http://localhost:3000"

# Required by the Node server when running locally.
PORT="3000"

# Optional: Firebase admin values if you want Firestore sync enabled.
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
